{
  "name": "c0data",
  "version": "0.4.1",
  "description": "C0DATA — structured data using ASCII C0 control codes (1.0 redesign)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c0data/c0-js.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/test.*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test 'dist/*.test.js' dist/test.js",
    "pretest": "tsc",
    "docs": "typedoc",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "c0",
    "c0data",
    "data-format",
    "control-codes",
    "ascii"
  ],
  "author": "Thomas Sawyer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.7.0"
  }
}
